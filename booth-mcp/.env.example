# manage.booth.pm のログイン済みCookieヘッダ全体。
#
# cookie自動同期（../booth-cookie-sync）を使う場合、このファイルは不要。
# 拡張が booth-mcp/.cookie を自動更新し、サーバーはそちらを優先して読む。
#
# 手動で入れる場合の取得方法:
#   Chromeで manage.booth.pm にログイン → F12 → Application → Cookies →
#   https://manage.booth.pm を選択 → `_plaza_session_*` の Name=Value を貼る
#   （複数必要なら "名前1=値1; 名前2=値2" のようにセミコロン区切りで並べる）
BOOTH_COOKIE=

# 受入テスト(src/probe.js)の対象商品ID。
# 中身を書き換えても構わない実験用の商品（非公開・下書き推奨）を指定すること。
ITEM_ID=
