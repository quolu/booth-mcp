{
  "manifest_version": 3,
  "name": "BOOTH Cookie Sync (booth-mcp)",
  "version": "1.0",
  "description": "manage.booth.pm のログイン済みcookieを booth-mcp の .env へ自動同期する。",
  "key": "",
  "background": { "service_worker": "background.js" },
  "permissions": ["cookies", "alarms", "nativeMessaging"],
  "host_permissions": ["https://manage.booth.pm/*", "https://*.booth.pm/*"],
  "action": { "default_title": "BOOTH cookieを今すぐ同期" }
}
